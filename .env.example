# ---------------------------------------------------------------------------
# AnsibleUI yapılandırması
# Bu dosyayı .env olarak kopyalayın. .env ASLA commit edilmez.
# Üretimde bu değerler Kubernetes ConfigMap ve Secret'larından gelir.
# ---------------------------------------------------------------------------

# --- Uygulama ---
ANSIBLEUI_ENV=development
ANSIBLEUI_LOG_LEVEL=INFO
ANSIBLEUI_API_BASE_URL=http://localhost:8000

# --- Veritabanı ---
ANSIBLEUI_DATABASE_URL=postgresql+asyncpg://ansibleui:ansibleui@postgres:5432/ansibleui

# --- Git çalışma kopyası (PVC üzerinde bağlanır) ---
ANSIBLEUI_REPO_PATH=/data/repo
ANSIBLEUI_REPO_URL=https://ktdevops/tfs/KT/KT.ITAutomation/_git/Ansible.appAdminConfig
ANSIBLEUI_REPO_DEFAULT_BRANCH=main
# UI tarafından açılan branch'lerin zorunlu ön eki. main'e yazma kod düzeyinde engellidir.
ANSIBLEUI_BRANCH_PREFIX=ansibleui

# --- Azure DevOps Server (on-prem TFS) ---
ANSIBLEUI_ADO_BASE_URL=https://ktdevops/tfs
ANSIBLEUI_ADO_COLLECTION=KT
ANSIBLEUI_ADO_PROJECT=KT.ITAutomation
ANSIBLEUI_ADO_REPOSITORY=Ansible.appAdminConfig
ANSIBLEUI_ADO_API_VERSION=6.0
# Personal Access Token. Üretimde Kubernetes Secret'tan gelir, asla loglanmaz.
ANSIBLEUI_ADO_PAT=

# Kurumsal kök sertifika demeti. TLS doğrulaması ASLA kapatılmaz.
ANSIBLEUI_CA_BUNDLE_PATH=

# --- Pipeline tanım eşlemesi (ortam -> Azure Pipelines definition id) ---
ANSIBLEUI_PIPELINE_NONPROD_ID=
ANSIBLEUI_PIPELINE_PROD_ID=
ANSIBLEUI_PIPELINE_DMZ_NONPROD_ID=
ANSIBLEUI_PIPELINE_DMZ_PROD_ID=

# --- Kimlik doğrulama ---
# local | ldap  (ldap Faz 8'de gelir)
ANSIBLEUI_AUTH_PROVIDER=local
# En az 32 karakter. Üretimde Secret'tan gelir.
ANSIBLEUI_JWT_SECRET=degistir-bu-degeri-en-az-32-karakter-olmali
ANSIBLEUI_JWT_TTL_MINUTES=60

# --- Arka plan işleri ---
ANSIBLEUI_INDEX_INTERVAL_SECONDS=60
ANSIBLEUI_RUN_POLL_INTERVAL_SECONDS=5

# --- Yapay zekâ (Faz 7, şimdilik devre dışı) ---
ANSIBLEUI_AI_ENABLED=false
ANSIBLEUI_AI_BASE_URL=
ANSIBLEUI_AI_MODEL=qwen2.5-coder-32b-instruct
ANSIBLEUI_AI_API_KEY=

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000
